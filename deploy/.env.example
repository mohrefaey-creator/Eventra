# The public address people will use, with DNS pointing at this server. No https:// here.
DOMAIN=mirror.example.com

# --- Android app (optional until you have built it) ---
# Where people download it, and the SHA-256 fingerprint of the key it is signed with
# (./gradlew :app:signingReport). The fingerprint lets a scanned QR open the app directly.
ANDROID_APP_URL=
ANDROID_CERT_SHA256=
ANDROID_PACKAGE=app.mirrorlink
IOS_APP_URL=

# --- TURN relay (optional; needed for devices on different networks) ---
# Generate a secret with:  openssl rand -hex 32
TURN_SECRET=
TURN_URLS=turn:mirror.example.com:3478,turn:mirror.example.com:3478?transport=tcp
# This server's public IP address (only used by the bundled coturn).
PUBLIC_IP=
